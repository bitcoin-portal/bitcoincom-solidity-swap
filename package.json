		"merkletreejs": "^0.2.13",
		"micromatch": "^4.0.2",
		"prettier": "^2.3.0",
		"prettier-plugin-solidity": "^1.0.0-beta.16",
		"rimraf": "^3.0.2",
		"solhint": "^3.3.6",
		"solidity-ast": "^0.4.25",
		"solidity-coverage": "0.8.0",
		"solidity-docgen": "^0.5.3",
		"truffle": "^5.4.12",
